{
  "name": "invoicepilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "demo": "node --import tsx src/server.ts --demo",
    "test": "node --import tsx --test tests/*.test.ts",
    "format": "prettier --write src web tests scripts vite.config.ts vercel.mjs",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0",
    "tsx": "^4.20.0",
    "pdfkit": "^0.17.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/pdfkit": "^0.17.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "concurrently": "^9.0.0",
    "prettier": "^3.0.0"
  }
}
